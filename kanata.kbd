(deflocalkeys-linux
 ! 161
)

(defsrc
 a   z   e   r   t   y   u   i   o   p
 caps   q   s   d   f   g   h   j   k   l   Semicolon
 w   x   c   v   b   n   KeyM   Comma   Period   Slash
 spc
)

(defvar
 tap-time   200
 hold-time  200
)

(defalias
  ;; Home row mods sans multi, sans f24
  q (tap-hold $tap-time $hold-time q lalt)
  s (tap-hold $tap-time $hold-time s rmet)
  d (tap-hold $tap-time $hold-time d lsft)
  f (tap-hold $tap-time $hold-time f lctl)
  j (tap-hold $tap-time $hold-time j rctl)
  k (tap-hold $tap-time $hold-time k rsft)
  l (tap-hold $tap-time $hold-time l rmet)
  m (tap-hold $tap-time $hold-time Semicolon ralt)
  
  caps (tap-hold 200 200 esc (layer-toggle numbers))
  nav (tap-hold $tap-time $hold-time spc (layer-toggle navigation))
)

(deflayer base
  _   _   _   _   _   _   _   _   _   _
  @caps   @q   @s   @d   @f   _  _   @j   @k   @l   @m
  _   _   _   _   _   _   _   _   _   _
  @nav
)

(deflayer navigation
  Tab   Home   PageUp   End   _   _   _   _   _   _
  _   _   left   down   right   PageDown   _   _   _   _   _
  _   _   _   _   _   _   _   _   _   _
  @nav
)

(deflayer numbers
  _   _   _   _   _   _   _   Numpad7   Numpad8   Numpad9  
  @caps   _   _   _   _   _   _   _   Numpad4   Numpad5   Numpad6
  _   _   _   _   _   _   _   Numpad1   Numpad2   Numpad3
  Numpad0
)
